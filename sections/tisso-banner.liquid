<section class="tisso-banner">

  <div class="tisso-banner__topbar">
    <div class="tisso-banner__logo">
      {{ section.settings.logo_text }}
    </div>

    <div class="tisso-banner__announcement">
      {{ section.settings.top_text }}
    </div>

    <a 
      href="{{ section.settings.top_button_link }}"
      class="tisso-btn tisso-btn--yellow"
    >
      {{ section.settings.top_button_text }}
      <span>→</span>
    </a>
  </div>


  <div class="tisso-banner__hero">

    <div class="tisso-banner__content">

      <h1>
        {{ section.settings.heading }}
      </h1>

      <div class="tisso-banner__description">
        {{ section.settings.description }}
      </div>


      <a
        href="{{ section.settings.button_link }}"
        class="tisso-btn tisso-btn--black"
      >
        {{ section.settings.button_text }}
        <span class="arrow">→</span>
      </a>

    </div>


    {% if section.settings.hero_image != blank %}
      <div class="tisso-banner__image">
        {{
          section.settings.hero_image
          | image_url: width: 1600
          | image_tag
        }}
      </div>
    {% endif %}

  </div>


  <div class="tisso-banner__footer">
    {{ section.settings.bottom_text }}
  </div>


</section>



{% schema %}
{
  "name": "Tisso Banner",

  "settings": [

    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo",
      "default": "TISSO VISON"
    },

    {
      "type": "text",
      "id": "top_text",
      "label": "Announcement text",
      "default": "Find the ideal gift for your loved ones."
    },

    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button text",
      "default": "Choose gift"
    },

    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top button link"
    },


    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts.</p>"
    },


    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },


    {
      "type": "text",
      "id": "button_text",
      "label": "Main button text",
      "default": "SHOP NOW"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Main button link"
    },


    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }

  ],

  "presets": [
    {
      "name": "Tisso Banner"
    }
  ]
}
{% endschema %}