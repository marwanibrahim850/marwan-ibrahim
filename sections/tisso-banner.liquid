<section class="tisso-banner">
  <header class="tisso-header">
    <div class="tisso-logo">{{ section.settings.logo }}</div>
  </header>
  <div class="tisso-topbar">
    <span>{{ section.settings.top_text }}</span>
    <a href="{{ section.settings.top_link }}">{{ section.settings.top_button }} →</a>
  </div>
  <div class="tisso-hero">
    <div class="tisso-copy">
      <h1>{{ section.settings.heading }}</h1>
      <div class="tisso-desc">{{ section.settings.description }}</div>
      <a class="tisso-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_text }} <span>→</span></a>
    </div>
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1400 | image_tag: class:'tisso-image' }}
    {% endif %}
  </div>
  <div class="tisso-footer">{{ section.settings.bottom_text }}</div>
</section>
{{ 'tisso.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name":"Tisso Banner","settings":[
{"type":"text","id":"logo","label":"Logo","default":"TISSO VISON"},
{"type":"text","id":"top_text","label":"Announcement","default":"Find the ideal gift for your loved ones."},
{"type":"text","id":"top_button","label":"Top button","default":"Choose gift"},
{"type":"url","id":"top_link","label":"Top link"},
{"type":"text","id":"heading","label":"Heading","default":"The Gift Guide"},
{"type":"richtext","id":"description","label":"Description"},
{"type":"text","id":"button_text","label":"Button text","default":"Shop now"},
{"type":"url","id":"button_link","label":"Button link"},
{"type":"image_picker","id":"image","label":"Hero image"},
{"type":"text","id":"bottom_text","label":"Bottom text","default":"Sustainable, ethically made clothes in sizes XXS to 6XL"}
],"presets":[{"name":"Tisso Banner"}]}
{% endschema %}