{% comment %}
  tisso-gift-illustration.liquid
  ---------------------------------------------------------------------------
  NOTE ON FIDELITY: this is a hand-recreated approximation of the Figma
  line-art (camera, lenses, watch, notebook, pen/pencil, compass, sunglasses,
  bow ribbon, laurel card, tape reels), built because the original vector
  asset could not be exported from Figma in this environment. Composition
  (dense scatter on the right, thinning toward the text on the left) matches
  the screenshots. Swap this snippet's contents for the real exported SVG
  whenever it's available, or use the "Artwork override" image setting on
  the Banner section.

  Uses stroke="currentColor" throughout so its color is controlled purely by
  CSS (.tisso-banner__artwork { color: ... }) instead of being baked in.
{% endcomment %}
<svg class="tisso-illustration" viewBox="0 0 760 520" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none">

    <!-- bow ribbon, top left -->
    <path d="M40 40c-30-20-30 40 0 20 30 20 30-40 0-20z" />

    <!-- sunglasses, left -->
    <g transform="translate(10,150)">
      <circle cx="35" cy="55" r="32" />
      <circle cx="105" cy="55" r="32" />
      <path d="M67 50h6" />
      <path d="M3 45 L15 35" />
      <path d="M137 45 L149 35" />
    </g>

    <!-- camera + map block, center-left -->
    <g transform="translate(90,60)">
      <rect x="0" y="30" width="230" height="150" rx="4"/>
      <path d="M20 45 L60 30 M60 30 L110 55 M110 55 L90 120" stroke-dasharray="2 5" />
      <circle cx="120" cy="105" r="46"/>
      <circle cx="120" cy="105" r="28"/>
      <circle cx="185" cy="80" r="20"/>
      <circle cx="185" cy="80" r="10"/>
      <rect x="195" y="45" width="24" height="16"/>
      <path d="M14 150 q30 -20 55 5 t60 -10" stroke-dasharray="2 4"/>
    </g>

    <!-- lens 1 -->
    <g transform="translate(345,10)">
      <rect x="0" y="0" width="70" height="130" rx="6"/>
      <rect x="10" y="95" width="50" height="10"/>
      <rect x="10" y="10" width="50" height="10"/>
    </g>

    <!-- lens 2, taller -->
    <g transform="translate(430,-5)">
      <rect x="0" y="0" width="80" height="160" rx="6"/>
      <rect x="8" y="16" width="64" height="10"/>
      <rect x="8" y="120" width="64" height="10"/>
      <circle cx="40" cy="70" r="4"/>
    </g>

    <!-- notebook + pen + pencil -->
    <g transform="translate(540,20)">
      <rect x="0" y="0" width="110" height="150" rx="4"/>
      <path d="M20 0v150 M0 30h110" />
      <rect x="128" y="0" width="10" height="150" rx="4"/>
      <path d="M170 4 L178 150 L186 4" />
    </g>

    <!-- laurel card, top right -->
    <g transform="translate(660,10)">
      <rect x="0" y="0" width="90" height="70" rx="4"/>
      <path d="M30 45c-10-15 0-30 15-15" />
      <path d="M60 45c10-15 0-30-15-15" />
      <line x1="20" y1="20" x2="70" y2="20"/>
      <line x1="30" y1="30" x2="60" y2="30"/>
      <circle cx="45" cy="55" r="3"/>
    </g>

    <!-- tape reels, right -->
    <g transform="translate(670,105)">
      <circle cx="20" cy="20" r="18"/>
      <circle cx="20" cy="20" r="7"/>
      <circle cx="60" cy="45" r="18"/>
      <circle cx="60" cy="45" r="7"/>
    </g>

    <!-- second camera block, right -->
    <g transform="translate(600,150)">
      <rect x="0" y="0" width="150" height="90" rx="8"/>
      <circle cx="45" cy="45" r="32"/>
      <circle cx="45" cy="45" r="18"/>
      <circle cx="120" cy="18" r="7"/>
    </g>

    <!-- watch, mid left -->
    <g transform="translate(15,270)">
      <path d="M0 40c40-25 110-25 150 0" />
      <path d="M0 70c40 25 110 25 150 0" />
      <circle cx="75" cy="55" r="38"/>
      <path d="M75 55 L75 30 M75 55 L95 65" />
    </g>

    <!-- compass -->
    <g transform="translate(370,300)">
      <circle cx="40" cy="40" r="38"/>
      <path d="M40 8v10 M40 62v10 M8 40h10 M62 40h10" />
      <path d="M40 20 L50 40 L40 60 L30 40 Z" />
    </g>

    <!-- third lens (bottom) -->
    <g transform="translate(500,290)">
      <rect x="0" y="0" width="80" height="150" rx="6"/>
      <rect x="8" y="18" width="64" height="10"/>
      <rect x="8" y="115" width="64" height="10"/>
      <circle cx="40" cy="65" r="4"/>
    </g>

    <!-- fourth camera, bottom right -->
    <g transform="translate(610,270)">
      <rect x="0" y="0" width="140" height="90" rx="8"/>
      <circle cx="42" cy="45" r="30"/>
      <circle cx="42" cy="45" r="17"/>
      <circle cx="112" cy="16" r="6"/>
    </g>

    <!-- second sunglasses + map, bottom left -->
    <g transform="translate(0,420)">
      <circle cx="35" cy="35" r="30"/>
      <circle cx="98" cy="35" r="30"/>
      <path d="M65 32h6" />
    </g>
    <g transform="translate(140,395)">
      <rect x="0" y="0" width="170" height="110" rx="4"/>
      <path d="M20 20 q40 -10 70 15 t60 -5" stroke-dasharray="2 4"/>
      <circle cx="120" cy="70" r="30"/>
      <circle cx="120" cy="70" r="16"/>
    </g>

    <!-- second bow ribbon, bottom center -->
    <path d="M330 470c-25-18-25 36 0 18 25 18 25-36 0-18z" />

  </g>
</svg>
